{
  "name": "@xbzbing/dsh-git-panel",
  "version": "1.10.1",
  "description": "DeepSeek Harness (dsh) plugin: an IDE-style Git panel in the Web GUI — branch/history overview, uncommitted changes with commit & amend, diff stats, and a zsh-style branch marker in the input bar.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xbzbing/dsh-git-panel.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/host/index.js",
  "types": "lib/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/host/index.d.ts",
      "default": "./lib/host/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/zh.json": "./locale/zh.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/ja.json": "./locale/ja.json",
    "./locale/es.json": "./locale/es.json",
    "./locale/fr.json": "./locale/fr.json",
    "./locale/de.json": "./locale/de.json",
    "./locale/ru.json": "./locale/ru.json",
    "./locale/pt.json": "./locale/pt.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/client.js",
    "lib/client.mermaid.js",
    "lib/host",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node build.mjs && node --test test/unit/*.test.mjs",
    "test:e2e": "node build.mjs && node test/e2e/setup.mjs && node test/e2e/all.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.7-rc.2",
      "dshReleases": {
        "0.1.7-rc.2": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.1": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "git",
    "web-ui",
    "diff",
    "commit"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-session": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.2-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "mermaid": "12.2.0",
    "playwright-core": "1.63.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
