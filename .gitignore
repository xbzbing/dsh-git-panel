# Dependencies
node_modules/

# lib/ is committed on purpose: `dsh plugin add github:xbzbing/dsh-git-panel`
# installs the committed tree without running a build. Only the test-only
# bundles stay untracked, because `npm run test:unit` rebuilds them first.
lib/testkit.mjs
lib/hookkit.mjs
*.tsbuildinfo

# Local-only docs (design notes, scratch, not for the repo)
docs/local/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.log

# Test / coverage
coverage/
.nyc_output/

# E2E vendored artifacts (copied at test time by test/e2e/setup.mjs)
test/e2e/client.js
test/e2e/react.production.min.js
test/e2e/react-dom.production.min.js
test/e2e/react-jsx-runtime.js

# Playwright browser cache / reports
ms-playwright/
playwright-report/
test-results/
*.tgz
